# Copy this file to server/.env and fill in the values.
# Everything is optional for local development: without a .env the server
# uses the local database started by `npm run dev` and a development secret.

# MongoDB connection string. For production, create a free cluster on
# MongoDB Atlas and paste its connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/inkboard

# Long random string used to sign login tokens. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts.
JWT_EXPIRES_IN=7d

# Port the API listens on (hosting providers usually set this for you).
PORT=5000

# "Continue with Google / GitHub" appears for each provider that has both values.
# The callback URL to register is <your address>/api/auth/oauth/<google|github>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public address of the app, used in sign-in redirects, e.g. https://inkboard.example.com.
# Leave empty to use the address each request arrives on.
APP_URL=

# Only needed when the client is hosted on a different domain than the API,
# e.g. https://inkboard.vercel.app. Separate multiple origins with commas.
CLIENT_ORIGIN=
