# Copy this file to server/.env and fill in the values.
# Everything is optional for local development: without a .env the server
# uses the local database started by `npm run dev` and a development secret.

# MongoDB connection string. For production, create a free cluster on
# MongoDB Atlas and paste its connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/inkboard

# Random string of at least 32 characters used to sign login tokens. Required unless NODE_ENV is
# "development" or "test" (`npm run dev` sets it), which may use a built-in secret for local work only.
# A shorter one stops the server from starting; replacing it logs everyone out once.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts. A bare number is seconds; or use a unit, e.g. 12h or 7d.
JWT_EXPIRES_IN=7d

# Port the API listens on (hosting providers usually set this for you).
PORT=5000

# Port of the local database that `npm run dev` starts, when MONGODB_URI is left unset or points at it.
# Only change it if 27017 is taken (another MongoDB is running).
# DEV_DB_PORT=27017

# "Continue with Google / GitHub" appears for each provider that has both values.
# The callback URL to register is <your address>/api/auth/oauth/<google|github>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Emails (verifying an address, resetting a password) are sent with Brevo's API, since
# Render's free plan blocks SMTP. EMAIL_FROM must be a sender you've verified in Brevo.
# Optional: leave them empty and email verification and password reset are switched off.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Inkboard

# Where people open the app, used in redirects after sign-in and in email links, e.g. https://inkboard.example.com.
# Required in production once email is set up (a request's Host header could otherwise choose the link),
# except on Render with no CLIENT_ORIGIN, where email links fall back to the service's address
# (RENDER_EXTERNAL_URL, with a warning); set it if people use a custom domain.
# Leave empty locally to use the address each request arrives on.
APP_URL=

# Public address of the API, which Google and GitHub send people back to. Only needed when it differs
# from APP_URL (client and API on different addresses).
API_URL=

# How many proxies are in front of the server, for rate limits per address. Default: 1 in production.
TRUST_PROXY=

# Most emails sent a day (Brevo's free plan stops at 300). 40% is kept for password resets, so sign-ups
# can't use it all. Counted in memory by each server process, starting again at 0 when it restarts.
EMAIL_DAILY_LIMIT=250

# Only needed when the client is hosted on a different domain than the API,
# e.g. https://inkboard.vercel.app. Separate multiple origins with commas.
CLIENT_ORIGIN=
