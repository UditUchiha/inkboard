{
  "name": "@inkboard/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --import ./scripts/dev-env.js src/index.js",
    "start": "node src/index.js",
    "db": "node scripts/dev-db.js",
    "test": "node --test --test-concurrency=2",
    "coverage": "node --test --test-concurrency=2 --experimental-test-coverage --test-coverage-exclude=\"**/tests/**\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@inkboard/shared": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4"
  }
}
