{
  "name": "inkboard",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time collaborative whiteboard with hand-drawn shapes, live cursors and sharing.",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n db,api,web -c yellow,blue,magenta \"npm:dev:db\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:db": "npm run db -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.9.9"
  }
}
