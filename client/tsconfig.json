{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The browser app: Vite resolves imports written without an extension, and turns JSX into React calls.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
